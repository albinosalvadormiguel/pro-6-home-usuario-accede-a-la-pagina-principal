{
  "name": "web_criterios",
  "version": "1.0.0",
  "description": "Versión inicial sobre la creación de web con sistema de criterios, features, criterios de aceptacion",
  "license": "ISC",
  "author": "Albino Salvador",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run css:build",
