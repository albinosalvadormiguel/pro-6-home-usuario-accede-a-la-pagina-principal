    "css:watch": "sass --watch src/styles/main.scss public/styles.css --no-source-map",
    "preview": "node server.js",
    "test": "npm run test:e2e",
    "test:e2e": "cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.1",
    "playwright": "^1.55.1",
    "sass": "^1.77.6",
    "vite": "^7.1.9"
  }
}
